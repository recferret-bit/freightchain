# Local split hosts (npm run infra:local). Sourced by npm run server:dev and npm run editor:worker.
# No secrets. *.localhost resolves to loopback; the edge is deploy/scripts/local.sh.
APP_DOMAIN=freightchain.localhost
APP_ORIGIN=http://freightchain.localhost
COOKIE_DOMAIN=freightchain.localhost
CORS_ORIGINS=http://freightchain.localhost,http://ride.freightchain.localhost,http://whitepaper.freightchain.localhost,http://pitchdeck.freightchain.localhost
TRUST_PROXY=1
