# Freight Chain – deploy settings and the production environment, in ONE file.
#   deploy/.env          the REAL one (gitignored)   – created by `npm run deploy:init`, then edit
#   deploy/.env.example  this file (tracked)         – dummy values only, never put a real secret here
#
# DEPLOY_* keys stay on your machine. Everything else is uploaded to the server as /srv/freightchain/.env (chmod 600) and feeds the containers.
# Values starting with CHANGE_ME are placeholders: `npm run deploy` refuses to run while any is left.

# ---------- where to deploy (stays local) ----------
DEPLOY_HOST=45.91.236.144
DEPLOY_USER=root
DEPLOY_PATH=/srv/freightchain
# The APEX domain, e.g. freightchain.fun – five names are served from it (nginx on the server, one Let's Encrypt certificate):
#   <apex>  landing + lobby   ride.<apex>  the game   api.<apex>  the API   storybook.<apex>  the model viewer   admin.<apex>  the admin page (basic auth)
# All five A records must point at DEPLOY_HOST (the session cookie is Secure, so https only). The cookie domain, CORS origins and the sign-in domain are DERIVED from this.
DEPLOY_DOMAIN=CHANGE_ME.example.com
# Let's Encrypt expiry notices go here
DEPLOY_LETSENCRYPT_EMAIL=CHANGE_ME@example.com
# loopback port of the app container on the server (nginx proxies to it)
DEPLOY_APP_PORT=3000
# how many releases (code + image) and database dumps to keep
DEPLOY_KEEP_RELEASES=3
DEPLOY_KEEP_BACKUPS=7
# HTTP basic auth in front of admin.<apex> (the admin page and its API; a wallet in ADMIN_WALLETS is needed as well). Stays local: the deploy writes only an
# apr1 hash to the server (/etc/nginx/freightchain-admin.htpasswd, on every deploy – change the password here and redeploy). `npm run deploy:init` generates one; >= 16 chars.
DEPLOY_ADMIN_USER=admin
DEPLOY_ADMIN_PASSWORD=CHANGE_ME_generated_by_deploy_init

# ---------- database (inside the compose network; never published) ----------
POSTGRES_USER=freight
POSTGRES_DB=freightchain
# hex only (no URL escaping needed) – `npm run deploy:init` generates one
POSTGRES_PASSWORD=CHANGE_ME_generated_by_deploy_init

# ---------- app ----------
# >= 32 chars – `npm run deploy:init` generates one. Changing it signs every rider out.
JWT_SECRET=CHANGE_ME_generated_by_deploy_init
# Where entry fees go: a PUBLIC wallet address you control (the server never holds the secret).
# `npm run deploy:init` generates a keypair locally (deploy/secrets/, gitignored, never uploaded) and puts its public key here.
TREASURY_PUBKEY=CHANGE_ME_public_key
# DEVNET only – the deploy refuses any other chain (it asks the endpoint for its genesis hash). A dedicated devnet URL (QuickNode / Helius / Triton: pick the *Devnet* network) avoids the public endpoint's rate limits; it contains an API key, so it lives only in deploy/.env.
SOLANA_RPC=https://api.devnet.solana.com
# reverse-proxy hops in front of the app: host nginx = 1
TRUST_PROXY=1
SESSION_TTL_DAYS=7
THROTTLE_LIMIT=600
THROTTLE_AUTH_LIMIT=30
FREE_RIDE_SECONDS=180
# demo video: comma-separated wallets (or *) whose PAID rides run DEMO_SCALE× shorter. Empty = real lengths.
DEMO_WALLETS=
DEMO_SCALE=60
# SOL the very first prize round starts with
INITIAL_SEED_SOL=0
# verified play: false = SHADOW mode – every completed shift is judged and the verdict shown, but the paid boards rank all of them. The production default
# (missing key) is false; set true once the thresholds are tuned. Rides from before verified play have no verdict and only rank in shadow mode.
VERDICT_ENFORCE=false
# days a ride's recording (telemetry batches) is kept after the ride ended; flagged rides are kept until reviewed; 0 = forever
TELEMETRY_RETENTION_DAYS=90
# the admin session (the page's own wallet sign-in → the fc_admin cookie, admin.<apex> only): its signing key (>= 32 chars; change it = every admin signed out;
# empty = derived from JWT_SECRET) and how long one sign-in lasts. `npm run deploy:init` generates the key.
ADMIN_JWT_SECRET=CHANGE_ME_generated_by_deploy_init
ADMIN_SESSION_TTL_MINUTES=120
# wallets (comma-separated base58) that may use https://admin.<apex> (behind DEPLOY_ADMIN_USER / _PASSWORD) – the review queue, rides, sign-ins, live logs. Empty = no admin page at all
ADMIN_WALLETS=
# pin the SOL/USD price (testing only). Empty = live Coinbase / CoinGecko.
SOL_USD=

# ---- escrowed pools / paid tickets (docs/paid-tickets-status.md). All optional: without TICKET_PROGRAM_ID the server runs the legacy pay-per-ride transfer mode.
# the deployed pool program (devnet) – set it and PAYMENT_MODE defaults to 'program'
TICKET_PROGRAM_ID=
# PUBLIC keys: defaults for new pools' seed / fee treasuries
FEE_TREASURY=
SEED_TREASURY=
# websocket of the same provider (unset = no live subscription, the 15 s poll still runs); read-only fallback RPCs, comma-separated
SOLANA_WS=
SOLANA_RPC_FALLBACKS=
# program-log watcher interval (0 = off)
WATCH_INTERVAL_MS=15000
# POST /api/chain/webhook secret (>= 16 chars; unset = the route answers 404)
WEBHOOK_SECRET=
# gas sponsor: base58 keypair holding FEE money only (unset = buyers pay their own fee). SECRET – never commit a real one.
FEE_PAYER_SECRET=
SPONSOR_PER_WALLET_PER_DAY=20
# the sponsor stops paying fees below this balance (SOL)
FEE_PAYER_MIN_SOL=0.05
# 'program' | 'transfer'. Unset: 'program' when TICKET_PROGRAM_ID is set, else 'transfer'
PAYMENT_MODE=
# base58 keypair paying fees for the permissionless cranks (fail_pool, refund). SECRET – never commit a real one.
CRANK_SECRET=
# priority fees: percentile of recent fees, clamped to [MIN, MAX] micro-lamports (use MIN=1000 on mainnet)
PRIORITY_FEE_PERCENTILE=75
PRIORITY_FEE_MIN_MICROLAMPORTS=0
PRIORITY_FEE_MAX_MICROLAMPORTS=50000
# 'confirmed' | 'finalized'
SOLANA_COMMITMENT=confirmed
# minutes a paid order stays payable; hours an on-chain session lasts (max 168)
ORDER_TTL_MINUTES=60
ONCHAIN_SESSION_TTL_HOURS=24
# minimum spacing of ride heartbeats (ms)
HB_MIN_INTERVAL_MS=1000
# PostHog product analytics (docs/analytics/index.html). Production file.
# POSTHOG_ENABLED=1 is the production opt-in. The key stays blank here. A value that is not phc_… is logged and ignored and does not refuse boot. Do not commit a real token.
# Local development is server/.env, which pins POSTHOG_ENABLED=0. POSTHOG_DISABLED=1 still wins.
# Project 297915 is EU Cloud. The US ingest host never shows up on the EU board. main's schema strips these until plan/posthog-integration is the image production runs.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=297915
POSTHOG_ENABLED=1
POSTHOG_DISABLED=

