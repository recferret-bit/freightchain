# nginx sites for Freight Chain – three names, one app container. Written ONCE by `npm run deploy:setup`; certbot then adds the TLS server blocks + the http→https redirects to the installed copy.
# __ROOT__ (the apex, e.g. freightchain.fun) and __PORT__ are filled in by deploy/scripts/remote/setup.sh.
#   __ROOT__        landing + lobby (static pages, served by the app)
#   ride.__ROOT__   the game (play.html + js/css)
#   api.__ROOT__    the API only – every other path is a 404
# The app serves client/ and /api on all three; the browser reaches the API on api.* with CORS + the session cookie of the shared parent domain (COOKIE_DOMAIN / CORS_ORIGINS in the app env).
# To add a domain/subdomain later: add a server block here (+ `certbot --nginx --expand -d ...`), and its origin to CORS_ORIGINS if the browser calls the API from it.

server {
    listen 80;
    listen [::]:80;
    server_name __ROOT__ ride.__ROOT__;
    include /etc/nginx/snippets/freightchain-media.conf;   # the cached hero loop (/media/*.mp4) – written by remote/setup.sh, which also adds this line to an already installed site

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;   # the server trusts exactly this one hop (TRUST_PROXY=1)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name api.__ROOT__;

    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / { return 404; }
}
