// Core metrics, kept as running totals so the landing, the lobby and /api/stats never scan the rides (docs/spec/platform_services.md). Written ONLY with atomic
// increments (`SET x = x + n`, never read-modify-write) by StatsService: when a ride ENDS (any path: /end, the heartbeat that fails it, the stale-ride
// sweep, a new ride clearing a stale one) the driver's PlayerStats row first, then the GlobalStats row, in the ride's own transaction; when a donation lands
// on a stream, the driver's row, then the global one. `stats:reconcile` (skill stats-reconcile) recomputes both from rides + feed events and fixes drift.
// What counts: every STARTED ride that ended (completed, abandoned, failed) – metres and seconds are what was really driven, so a failed shift still counts.

// One row per rider who ever finished a ride (wallet = PK).
model PlayerStats {
  wallet          String   @id
  player          Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  rides           Int      @default(0) // started rides that ended, whatever the outcome (= ridesFree + ridesPaid)
  ridesFree       Int      @default(0) // … free rides (tier free)
  ridesPaid       Int      @default(0) // … paid rides (tickets)
  ridesCompleted  Int      @default(0) // … of which complete shifts
  seconds         Float    @default(0) // driven (game) seconds
  metres          Float    @default(0)
  crashesVehicle  Int      @default(0) // truck ⇄ car / truck / bus … (every contact, bumps included)
  crashesBuilding Int      @default(0) // truck ⇄ roadside building (always fatal)
  donations       Int      @default(0) // donations that landed on this driver's streams (mock + paid)
  donationLamports BigInt  @default(0) // … lamports of the PAID ones only (money that moved)
  updatedAt       DateTime

  @@index([metres]) // the admin STATS tab: top riders by distance
  @@index([rides]) // global stats active drivers count (rides > 0)
  @@schema("stats")
}

// The whole game in one row (id is always 1).
model GlobalStats {
  id              Int      @id
  rides           Int      @default(0)
  ridesFree       Int      @default(0)
  ridesPaid       Int      @default(0)
  ridesCompleted  Int      @default(0)
  seconds         Float    @default(0)
  metres          Float    @default(0)
  crashesVehicle  Int      @default(0)
  crashesBuilding Int      @default(0)
  donations       Int      @default(0)
  donationLamports BigInt  @default(0)
  updatedAt       DateTime

  @@schema("stats")
}

// One row per UTC day (the day a ride ENDED / a donation landed): the history behind GET /api/stats/daily. Same columns, same writer (StatsService), written
// third in the lock order (rider, game, day) and repaired by stats:reconcile.
model DailyStats {
  day             DateTime @id @db.Date
  rides           Int      @default(0)
  ridesFree       Int      @default(0)
  ridesPaid       Int      @default(0)
  ridesCompleted  Int      @default(0)
  seconds         Float    @default(0)
  metres          Float    @default(0)
  crashesVehicle  Int      @default(0)
  crashesBuilding Int      @default(0)
  donations       Int      @default(0)
  donationLamports BigInt  @default(0)
  updatedAt       DateTime

  @@schema("stats")
}

// One row per ride (docs/spec/rides.md §21.2). The verdict worker fills it; this migration only creates the table.
// Null means "not measured yet". Ranking reads S/D/Srv columns; clientReported is the cross-check only.
model RideResult {
  rideId               String   @id
  ride                 Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  wallet               String
  poolId               Int?
  tier                 String?
  trip                 String?
  roadSeed             Int?
  attemptNo            Int?
  rulesVersion         Int?
  finishRulesVersion   Int?
  scoreInputsVersion   Int?
  simHz                Int?
  finished             Boolean?
  finishReason         String?
  finishS              Float?
  distanceM            Float?
  driveSeconds         Float?
  driveToFinishSeconds Float?
  wallSeconds          Float?
  pausedSeconds        Float?
  pauseCount           Int?
  avgSpeedKmh          Float?
  maxSpeedKmh          Float?
  hullAtFinish         Float?
  damageTotal          Float?
  damageHoles          Float?
  damageVehicles       Float?
  damageProps          Float?
  damageCold           Float?
  damageOther          Float?
  holesHit             Int?
  holesHitByType       Json?
  crashesVehicle       Int?
  crashesBuilding      Int?
  crashesProp          Int?
  offroadSeconds       Float?
  offroadEpisodes      Int?
  signalsPassed        Int?
  redLightViolations   Int?
  amberPasses          Int?
  redLightDetail       Json?
  stopLineViolations   Int?
  speedingSeconds      Float?
  mgIssued             Int?
  mgPassed             Int?
  mgWrong              Int?
  mgMissed             Int?
  mgPenaltySeconds     Float?
  mgMode               String?
  mgDetail             Json?
  verdictTier          String?
  verdictReasons       Json?
  humannessScore       Float?
  featureScores        Json?
  clientReported       Json?
  score                Float?
  scoreFormulaVersion  Int?
  replayId             String?
  computedAt           DateTime?
  durationMs           Int?
  effectiveDurationMs  Int?
  redLights            Int?
  offRoadSeconds       Float?
  mgTotal              Int?
  compositeScore       Float?
  createdAt            DateTime

  @@index([poolId, finished, verdictTier])
  @@index([poolId, driveToFinishSeconds])
  @@index([wallet, computedAt])
  @@index([poolId, compositeScore])
  @@index([wallet, createdAt])
  @@schema("stats")
}
