// The live feed of a ride (spectators – docs: docs/spec/replays_streams.md "Live streams"): a chat line or a MOCK donation (nothing is charged, no chain yet), optionally with an
// effect the driver's game applies (night / day / an obstacle on the road). Append-only, except for the driver's "applied" stamp.
// Rate limits without a lock: (rideId, slotKey, slot) is unique – slotKey 'fx' = one effect per ride per window, 'msg:<wallet>' / 'tip:<wallet>' = one line per
// wallet per window – so two racing posts cannot both take the same window (domain/live/live-rules.ts).
model RideEvent {
  id         Int       @id @default(autoincrement())
  rideId     String
  ride       Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  wallet     String // the spectator who posted it
  kind       String // message | donation
  text       String?
  effect     String? // donations: tip | night | day | potholes | trench | sinkhole
  lamports   BigInt    @default(0) // MOCK amount – shown, never charged
  slotKey    String
  slot       Int // createdAt / the window length of slotKey
  createdAt  DateTime
  appliedAt  DateTime? // effects: when the driver's game applied it …
  appliedT   Float? // … at that game time (driven seconds)
  appliedS   Float? // … where on the road (an obstacle: its position, so a replay puts it in the same place)
  appliedLat Float? // … and across the road (obstacles)
  signature  String?   @unique // a PAID donation: the transfer that paid it (LIVE_FREE_DONATIONS=off) – one transaction pays one event
  replayT    Int? // replay second this chat line is bound to (null = a line from before time-binding)
  hiddenAt   DateTime? // moderator hid it (P01). Null = visible.
  hiddenBy   String? // wallet that hid it

  @@unique([rideId, slotKey, slot])
  @@index([rideId, id])
  @@index([rideId, appliedAt])
  @@index([kind, createdAt])
  @@schema("live")
}

// The driver muted this spectator on this ride: the wallet can no longer post there, its chat lines are hidden from every feed and its donation notes
// blanked (its applied effects stay – every replay still needs where an obstacle went). Set / cleared by the ride's owner only.
model RideMute {
  rideId  String
  ride    Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  wallet  String
  mutedAt DateTime

  @@id([rideId, wallet])
  @@schema("live")
}

// A paid donation in flight (LIVE_FREE_DONATIONS=off): created when the spectator clicks, paid by a SOL transfer from the spectator to the driver with
// memo `fc-donation:<id>`, and only then turned into a RideEvent (a new id – a feed cursor never skips it). The claim is ONE conditional update
// (pending → paid, the signature unique), so two racing confirms of one transaction create one event.
model DonationOrder {
  id        String    @id
  rideId    String
  ride      Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  wallet    String // the spectator who pays
  recipient String // the driver's wallet – the transfer's destination
  effect    String
  note      String?
  lamports  BigInt
  status    String // pending | paid
  signature String?   @unique
  eventId   Int? // the RideEvent it became
  paymentReference String? @unique // Solana Pay reference on the driver's transfer
  referrer  String? // the driver's referrer, when this order reserved a share of the tip
  shareLamports BigInt @default(0)
  shareState String? // reserved | paid | released – null when the whole tip goes to the driver
  createdAt DateTime
  paidAt    DateTime?

  @@index([rideId])
  @@index([referrer, recipient, shareState])
  @@schema("live")
}

// Replay chat row (SPC-04.8). RideEvent stays the legacy feed; this table is the time-bound chat Lane 2 reads.
model LiveChat {
  id        String    @id
  rideId    String
  ride      Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  wallet    String
  text      String
  replayT   Int       @default(0)
  hiddenAt  DateTime?
  hiddenBy  String?
  createdAt DateTime  @default(now())

  @@index([rideId, replayT])
  @@schema("live")
}
