enum RideStatus {
  created
  awaiting_payment
  running
  completed
  abandoned
  failed
  expired
  cancelled

  @@schema("ride")
}

model Ride {
  id             String          @id @default(uuid())
  seq            BigInt          @default(autoincrement()) // insertion order: the tie-breaker when timestamps are equal
  wallet         String
  player         Player          @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  tier           String
  seed           Int // 31-bit road seed
  minSeconds     Float
  completeDist   Float
  status         RideStatus
  createdAt      DateTime
  trafficVersion Int             @default(0) // frame-proof protocol stamped by the server at start; historical rides remain 0
  timeScale      Float           @default(1) // > 1 = a DEMO ride (the shift is that many times shorter)
  priceUsd       Float           @default(0)
  lamports       BigInt          @default(0)
  solUsd         Float?
  quoteExpiresAt DateTime?
  roundId        Int?
  round          Round?          @relation(fields: [roundId], references: [id])
  poolId         Int? // the prize pool whose ticket paid for this ride (null = free, or a legacy pay-per-ride order)
  pool           Pool?           @relation(fields: [poolId], references: [id])
  paidAt         DateTime?
  startHour      Float? // the clock hour the ride starts at, assigned with `route` at creation from the seed (domain/rides/ride-rules.ts worldFor); null = a ride from before this
  route          String? // the theme id the SERVER assigned at creation from the seed (worldFor); rides from before this keep what the game reported
  loadout        Json? // what the driver wore when the ride STARTED ({ wheel, truck_color, gearbox } – promo cosmetics, visuals only): spectators and replays draw it; null = everything classic
  trip           String? // the road it was driven on: a client/js/trips.js id stamped at creation from the tier (domain/rides/ride-trip.ts) – replays rebuild THAT road; null = a ride from before trips ('classic')
  tutorial       Boolean         @default(false) // a FREE ride ordered with the step-by-step tutorial on (the game shows the dialog; starting it marks Player.tutorialPassedAt)
  assist         Boolean         @default(false) // a FREE ride ordered with ASSIST on: the truck wears out half as fast, every control gets a tip – never counts for the 'unassisted' achievement
  nightSeconds   Float           @default(0)
  crashesVehicle  Int            @default(0) // the game's running count of truck ⇄ vehicle contacts (cumulative in every report, only ever raised – statistics, not security)
  crashesBuilding Int            @default(0) // … and of building crashes
  paused         Boolean         @default(false)
  startedAt      DateTime?
  lastHbAt       DateTime?
  lastS          Float           @default(0)
  lastT          Float           @default(0)
  driveSeconds   Float           @default(0)
  hull           Float?
  endedAt        DateTime?
  reason         String?
  challenges     Json? // the dispatch prompts issued ([{ id, action, issuedMs, deadlineMs }], ms since startedAt – domain/rides/ride-challenge.ts); null = none yet
  nextChallengeAt Float? // drive-seconds at which the next prompt is due
  version        Int             @default(1) // optimistic lock: heartbeat vs end
  payment        Payment?
  batches        RideBatch[]
  events         RideEvent[]
  mutes          RideMute[]
  donationOrders DonationOrder[]
  liveChats      LiveChat[]
  verdict        RideVerdict?
  replays        RideReplay[]
  paymentReference String? @unique // Solana Pay reference (base58 of 32 bytes). Null until the first payment transaction is built.
  seedCommitment   String?
  blockhash        String?
  slot             BigInt?
  ranked         Boolean         @default(false) // declared before start; spectator road effects are refused and the ride can score on the weekly skill board
  cleanMetres    Float? // metres before the first hull drop or crash; null = still clean (the score is lastS)
  prizeCountry   String? // ISO country from the edge headers at the ranked start; null on an unranked ride
  prizeRegion    String? // USPS state when prizeCountry is US
  promoCode      String? // ride promo that granted this shift; null = not a promo ride. Not a purchase and it does not mint TEN4
  weeklyGrant    Boolean         @default(false) // the week's granted paid ticket (AMOE). Not a purchase and it does not mint TEN4.
  mgCommit         String? // hex SHA-256 of the minigame salt bytes. Null on training rides and when MINIGAMES is off. The salt itself is not a column.
  mgSaltVersion    String? // the label concatenated into the HMAC (default mg:v1)
  mgSaltRevealedAt DateTime? // set the first time GET ride returns the salt, which is only after a verdict
  mgMode           String? // normal | more-time, from POST start
  mgLang           String? // en | ru, from POST start
  sessionKey       String? // base64 of 32 bytes, set at start when TELEMETRY_V21 is shadow. Not returned on GET. Not encrypted at rest.
  pauseCount       Int             @default(0) // rising edges of the heartbeat paused flag
  pauseSeconds     Float           @default(0) // wall seconds of heartbeats that arrived paused
  trafficSaltCommit String? // sha256 hex of the traffic salt. Null when TELEMETRY_V21 is off. Not an input to the road.
  holeSaltCommit    String? // sha256 hex of the hole salt. Null when TELEMETRY_V21 is off. Not an input to the road.
  trafficSalt       String? // enforce start. Re-derived from the session key. Not returned on GET.
  holeSalt          String? // enforce start. Re-derived from the session key. Not returned on GET.
  saltCommit        String? // sha256 of the two commit hexes. Null until enforce start.
  minigames        RideMiniGame[]
  pledges          Pledge[]
  finishRulesVersion Int? // FINISH_RULES_VERSION stamped at creation; null = a ride from before the dynamic finish
  result             RideResult?
  appeal             RideAppeal?

  @@index([wallet, status])
  @@index([status, lastHbAt])
  @@index([roundId, status])
  @@index([wallet, startedAt])
  @@index([poolId, status])
  @@index([status, endedAt]) // the replays history: ended rides, newest end first
  @@index([createdAt(sort: Desc), seq(sort: Desc)]) // the admin RIDES list, newest first
  @@index([wallet, createdAt(sort: Desc)]) // …of one wallet (a player's latest rides)
  @@index([status, trip]) // the free leaderboard per level: completed free rides on one level's trip
  @@index([wallet, ranked, startedAt]) // ranked starts this prize week, under the player lock
  @@index([tier, ranked, status, startedAt]) // the weekly skill board
  @@index([status, paidAt(sort: Desc), seq(sort: Desc)]) // the /api/live upcoming rides list
  @@index([status, roundId]) // the round leaderboard
  @@schema("ride")
}

/** One issued phone minigame. The salt and the expected code are not stored. `answerHash` is sha256(eventId + ":" + normalized). */
model RideMiniGame {
  id            String    @id
  rideId        String
  ride          Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  ordinal       Int
  kind          String
  status        String
  variantSeq    Int       @default(0)
  trigger       String
  armedAtMs     Int
  bayDeadlineMs Int?
  slotS         Float?
  windowMs      Int
  revealedAt    DateTime?
  answeredAt    DateTime?
  attempts      Int       @default(0)
  outcome       String?
  penaltyS      Int       @default(0)
  answerHash    String?
  clientSafe    Boolean?
  nonce         String?
  mgDetail      Json?
  rulesVersion  String    @default("mg:1")

  @@unique([rideId, ordinal])
  @@index([rideId])
  @@schema("ride")
}

// One road per paid tier per UTC day for the pay-per-ride orders (PAYMENT_MODE=transfer, no pool): the first order of the day draws the seed, every later order of that
// tier that day takes it, so the day's riders all drive the same ride (route, start hour, layout, holes). Ticket rides take their POOL's seed instead (economy.Pool.rideSeed).
model DailySeed {
  tier      String // '1h' | '4h' | '8h'
  day       String // the UTC day the ride was ORDERED, YYYY-MM-DD
  seed      Int // 31-bit road seed, like Ride.seed
  createdAt DateTime

  @@id([tier, day])
  @@schema("ride")
}

// One appeal per pool ride. open until a signed admin upholds or denies it. commit_winners waits on status = open.
model RideAppeal {
  id         String    @id
  rideId     String    @unique
  ride       Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  wallet     String
  poolId     Int
  reason     String
  status     String    @default("open") // open | upheld | denied
  createdAt  DateTime
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?

  @@index([poolId, status])
  @@schema("ride")
}
