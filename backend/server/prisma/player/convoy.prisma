// Separate from legacy referrals: pending Convoy invitations can expire and be rebound.
model ConvoyInvite {
  referee String @id
  referrer String
  status String
  boundAt DateTime
  expiresAt DateTime
  activatedAt DateTime?
  qualifyExpiresAt DateTime?
  m1At DateTime?
  m2At DateTime?
  // Immutable activation promises; null preserves pre-settings defaults.
  policy Json?

  @@index([referrer, status])
  @@index([status, expiresAt])
  @@schema("player")
}

model ConvoyLedger {
  id String @id
  kind String
  wallet String
  referrer String
  referee String
  amount Int
  minTrust Int @default(50)
  unit String
  at DateTime
  dayKey String
  weekKey String
  releasedAt DateTime?
  // Historical ledger rows require operator review; only newly earned milestones enter settlement.
  chainState String @default("legacy")
  paidUnits BigInt @default(0)
  chainLeaseId String?
  chainRetryAt DateTime?
  chainSignature String?
  chainLastValidBlockHeight Int?
  chainResolvedAt DateTime?
  capReason String?

  @@index([chainState, chainRetryAt, at])

  @@index([kind, weekKey])
  @@schema("player")
}

model ConvoyRide {
  rideId String @id
  wallet String
  at DateTime
  trip String?
  counted Boolean

  @@index([wallet, at])
  @@schema("player")
}
