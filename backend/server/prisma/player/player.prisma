// A rider = a Solana wallet. The wallet address IS the primary key (it is the identity; there is no email / password).
model Player {
  wallet       String              @id
  version      Int                 @default(1) // optimistic lock for save()
  freeRides    Int // retired counted balance. Training rides are unlimited. The column stays so an old number can still be read.
  freeDay      String // retired UTC day of the last daily grant. The column stays.
  freeRidesMax Int                 @default(5) // retired daily-cap mirror. The column stays.
  guest        Boolean             @default(false) // anonymous EASY session. The secret was never stored. Progress does not merge into a later wallet.
  createdAt    DateTime
  tutorialPassedAt DateTime? // the first time a ride was STARTED with the tutorial on – the lobby then defaults the tutorial off (null = never)
  age18At      DateTime? // when the rider ticked "I am 18 or older" (null = off). Both stamps are required before a paid shift.
  lossAt       DateTime? // when the rider ticked the loss offer: SOL spent on a shift can be lost (null = off)
  rides        Ride[]
  payments     Payment[]
  achievements AchievementUnlock[]
  tickets      RideTicket[]
  orders       TicketOrder[]
  signIns      SignIn[]
  cosmetics    CosmeticUnlock[]
  equipped     CosmeticEquip[]
  stats        PlayerStats?
  sponsorPledges Pledge[] @relation("SponsorPledges")
  driverPledges  Pledge[] @relation("DriverPledges")
  chatBannedUntil DateTime? // replay chat: a wallet banned until this instant (null = not banned)
  convoyHidden    Boolean             @default(false) // omit this wallet from the public Convoy top 25
  trustScore      Int                 @default(60) // no browser fingerprint. Login, verdict, and social binding move it.
  trustSignals    Json? // the events that moved trustScore. Not a device id.
  termsVersion    Int                 @default(1)
  privacyVersion  Int                 @default(1)
  referralCode   ReferralCode?
  referralsOut   Referral[] @relation("AsReferrer")
  referralIn     Referral?  @relation("AsReferee")
  weeklyTickets  WeeklyTicket[]
  airdropClaims  AirdropClaim[]

  @@index([createdAt]) // the admin PLAYERS list: newest first
  @@index([freeDay]) // retired with the daily grant; left in place
  @@schema("player")
}

// One granted paid ticket per tier per interval. Not a purchase. Does not mint TEN4.
// An unused row expires at the next interval of that tier, or Sunday 12:00 UTC, whichever is earlier.
model WeeklyTicket {
  wallet      String
  player      Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  weekId      String // prize week the row was issued in (the Monday, YYYY-MM-DD)
  tier        String // 1h | 4h | 8h
  periodStart DateTime // start of this tier's grant interval
  expiresAt   DateTime
  rideId      String?  @unique
  createdAt   DateTime

  @@id([wallet, tier, periodStart])
  @@schema("player")
}

// A visual a promo code unlocked (wheel / truck_color / gearbox – the catalog is domain/economy/cosmetics.ts; the DEFAULT of a slot is implicit and never stored).
model CosmeticUnlock {
  wallet String
  player Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  slot   String
  item   String
  code   String // the promo code that gave it
  at     DateTime

  @@id([wallet, slot, item])
  @@schema("player")
}

// What a wallet wears: one row per slot it changed from the default.
model CosmeticEquip {
  wallet String
  player Player @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  slot   String
  item   String

  @@id([wallet, slot])
  @@schema("player")
}

// Sign-In With Solana challenge: one pending per wallet, consumed (deleted) by the first verify attempt.
model AuthChallenge {
  wallet    String   @id
  message   String // the exact text the wallet must sign – built by the server
  expiresAt DateTime

  @@schema("player")
}

enum TicketSource {
  payment
  promo
  admin
  spend
  refund
  void

  @@schema("player")
}

// A wallet's tickets in ONE pool (balance = still unused, bought = ever paid on chain, so the pool's per-wallet cap can be checked). Mirrors Player.freeRides.
model RideTicket {
  wallet  String
  player  Player @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  poolId  Int
  pool    Pool   @relation(fields: [poolId], references: [id])
  balance Int    @default(0)
  bought  Int    @default(0)
  version Int    @default(1) // optimistic lock for save()

  @@id([wallet, poolId])
  @@index([poolId])
  @@schema("player")
}

// Every change of a ticket balance – append-only audit trail (admin panel, support, "why do I have N tickets").
model TicketGrant {
  id     String       @id @default(uuid())
  wallet String
  poolId Int
  delta  Int // +n (payment / promo / admin / refund), -1 (spend), -n (void); 0 = a payment that hit the cap (see ref)
  source TicketSource
  ref    String? // Payment.signature, PromoCode.code, admin note or Ride.id
  at     DateTime

  @@index([wallet, at])
  @@index([poolId])
  @@schema("player")
}

// One row per successful sign-in (verify): the admin page's view of who signs in, when and from where. Sessions themselves are signed cookies
// (JWT) – there is no session table, and a single session cannot be revoked (rotating JWT_SECRET signs everybody out).
model SignIn {
  id        BigInt   @id @default(autoincrement())
  wallet    String
  player    Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  at        DateTime
  ipHash    String? // HMAC-SHA256 of canonical IPv4 /24 or IPv6 /48; never raw IP or UA

  @@index([at])
  @@index([wallet, at])
  @@schema("player")
}

// Owner-tweakable integers. A missing row falls back to the code default in domain/settings/game-settings.ts.
model GameSetting {
  key   String @id
  value Int

  @@schema("player")
}

// The wallet's invite code and the cab colour it gives a friend. Off the Player row so a player snapshot stays the credits and the stamps.
model ReferralCode {
  wallet    String   @id
  player    Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  code      String   @unique
  gift      String   @default("convoy") // convoy | signal | amber
  createdAt DateTime

  @@schema("player")
}

// One referrer per wallet, ever. referee is the key. status expired is a tombstone: the slot returns, the wallet cannot bind again.
model Referral {
  referee      String    @id
  refereePlayer Player   @relation("AsReferee", fields: [referee], references: [wallet], onDelete: Cascade)
  referrer     String
  referrerPlayer Player  @relation("AsReferrer", fields: [referrer], references: [wallet], onDelete: Cascade)
  status       String // pending | qualified | expired
  boundAt      DateTime
  expiresAt    DateTime
  qualifiedAt  DateTime?
  rideId       String?
  freeGranted  Boolean   @default(false)
  badgeCounted Boolean   @default(false)
  activatedAt  DateTime? // pending → active (Convoy). Null on a legacy row.
  qualifyExpiresAt DateTime? // active window end (activatedAt + 60d). Null until activation.
  m1QualifiedAt DateTime?
  m2QualifiedAt DateTime?

  @@index([referrer, status])
  @@schema("player")
}

// One social binding per wallet per campaign. telegram / x / discord ids are 1:1 across wallets (nulls do not collide).
model AirdropClaim {
  wallet         String
  campaign       String   @default("preseason")
  player         Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  telegramUserId String?  @unique
  xUserId        String?  @unique
  discordUserId  String?  @unique
  xHandle        String?
  heldAt         DateTime?
  rideVerifiedAt DateTime?
  telegramAt     DateTime?
  telegramGroupAt DateTime?
  telegramActiveAt DateTime?
  rulesAcceptedAt DateTime?
  attemptGrantedAt DateTime?
  xAttemptAt DateTime?
  xVerifiedAt DateTime?
  xPostId String?
  xAt            DateTime?
  turnstileAt    DateTime?
  claimedAt      DateTime?
  points         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@id([wallet, campaign])
  @@schema("player")
}

/// Conservative integer-cent reservations, made before external X requests. Failed calls remain charged.
model CampaignProviderBudget {
  campaign String @id
  reservedCents Int @default(0)
  @@schema("player")
}
