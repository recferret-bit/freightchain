# Freight Chain – deploy settings and the production environment, in ONE file.
#   deploy/.env          the REAL one (gitignored)   – created by `npm run deploy:init`, then edit
#   deploy/.env.example  this file (tracked)         – dummy values only, never put a real secret here
#
# DEPLOY_* keys stay on your machine. Everything else is uploaded to the server as /srv/freightchain/.env (chmod 600) and feeds the containers.
# Values starting with CHANGE_ME are placeholders: `npm run deploy` refuses to run while any is left.

# ---------- where to deploy (stays local) ----------
DEPLOY_HOST=45.91.236.144
DEPLOY_USER=root
DEPLOY_PATH=/srv/freightchain
# The APEX domain, e.g. freightchain.fun – seven names are served from it (nginx on the server, one Let's Encrypt certificate):
#   <apex>  landing + lobby   ride.<apex>  the game   api.<apex>  the API   storybook.<apex>  the model viewer   whitepaper.<apex>  the whitepaper   pitchdeck.<apex>  the pitch deck   admin.<apex>  the admin page (basic auth)
# All seven A records must point at DEPLOY_HOST (the session cookie is Secure, so https only). The cookie domain, CORS origins and the sign-in domain are DERIVED from this.
DEPLOY_DOMAIN=CHANGE_ME.example.com
# Let's Encrypt expiry notices go here
DEPLOY_LETSENCRYPT_EMAIL=CHANGE_ME@example.com
# loopback port of the app container on the server (nginx proxies to it)
DEPLOY_APP_PORT=3000
# how many releases (code + image) and database dumps to keep
DEPLOY_KEEP_RELEASES=3
DEPLOY_KEEP_BACKUPS=7
# HTTP basic auth in front of admin.<apex> (the admin page and its API; a wallet in ADMIN_WALLETS is needed as well). Stays local: the deploy writes only an
# apr1 hash to the server (/etc/nginx/freightchain-admin.htpasswd, on every deploy – change the password here and redeploy). `npm run deploy:init` generates one; >= 16 chars.
DEPLOY_ADMIN_USER=admin
DEPLOY_ADMIN_PASSWORD=CHANGE_ME_generated_by_deploy_init

# ---------- database (inside the compose network; never published) ----------
POSTGRES_USER=freight
POSTGRES_DB=freightchain
# hex only (no URL escaping needed) – `npm run deploy:init` generates one
POSTGRES_PASSWORD=CHANGE_ME_generated_by_deploy_init

# ---------- app ----------
# NODE_ENV is set by compose (`production`). Empty RESPONSE_SCHEMA_CHECK is unset: the app then warns.
RESPONSE_SCHEMA_CHECK=
# >= 32 chars – `npm run deploy:init` generates one. Changing it signs every rider out.
JWT_SECRET=CHANGE_ME_generated_by_deploy_init
# Where entry fees go: a PUBLIC wallet address you control (the server never holds the secret).
# `npm run deploy:init` generates a keypair locally (deploy/secrets/, gitignored, never uploaded) and puts its public key here.
TREASURY_PUBKEY=CHANGE_ME_public_key
# DEVNET only – the deploy refuses any other chain (it asks the endpoint for its genesis hash). A dedicated devnet URL (QuickNode / Helius / Triton: pick the *Devnet* network) avoids the public endpoint's rate limits; it contains an API key, so it lives only in deploy/.env.
SOLANA_RPC=https://api.devnet.solana.com
# Solana Name Service (SNS / .sol) resolution – always Mainnet-Beta (escrow/tickets run on Devnet).
# A dedicated Mainnet RPC URL (Helius/QuickNode/Triton) avoids public endpoint throttling.
SNS_RPC=https://api.mainnet-beta.solana.com
SNS_RPC_FALLBACKS=
SNS_CACHE_TTL_SECONDS=86400
SNS_NEGATIVE_CACHE_TTL_SECONDS=1800
# reverse-proxy hops in front of the app: host nginx = 1
TRUST_PROXY=1
SESSION_TTL_DAYS=7
THROTTLE_LIMIT=600
THROTTLE_AUTH_LIMIT=30
THROTTLE_PROMO_LIMIT=30
THROTTLE_ENTITIES_LIMIT=120
THROTTLE_EDITOR_LIMIT=240
THROTTLE_AUTH_RPS=5
THROTTLE_ENTITIES_RPS=5
THROTTLE_EDITOR_RPS=10
THROTTLE_MCP_LIMIT=600
THROTTLE_MCP_RPS=20
FREE_RIDE_SECONDS=180
# demo video: comma-separated wallets (or *) whose PAID rides run DEMO_SCALE× shorter. Production strict mode refuses any value, including *. Empty = real lengths.
DEMO_WALLETS=
DEMO_SCALE=60
# SOL the very first prize round starts with
INITIAL_SEED_SOL=0
# verified play: false = SHADOW mode – every completed shift is judged and the verdict shown, but the paid boards rank all of them. The production default
# (missing key) is false; set true once the thresholds are tuned. Rides from before verified play have no verdict and only rank in shadow mode.
VERDICT_ENFORCE=false
# days a ride's recording (telemetry batches) is kept after the ride ended; flagged rides are kept until reviewed; 0 = forever
TELEMETRY_RETENTION_DAYS=90
# shadow batch MAC beside the v1 hash. off = no session key. shadow checks protocol 2. The 10 Hz verifier stays.
TELEMETRY_V21=off
SIGNIN_RETENTION_DAYS=90
CHALLENGE_INTERVAL_SECONDS=240
CHALLENGE_FREE_RIDES=off
# phone minigames. off until a secret is set. shadow stores rows and leaves the verdict alone; enforce may flag an unsafe open
MINIGAMES=off
MG_SECRET=
MG_SALT_VERSION=mg:v1
# live streams (spectators). The deploy check uses the schema default when a key is missing, not the compose fallback:
# a missing LIVE_FREE_DONATIONS is `on` and fails, a missing LIVE_EFFECTS is `all` and fails. Compose explicitly defaults both to off.
LIVE_CHAT=all
LIVE_DONATIONS=on
LIVE_FREE_DONATIONS=off
LIVE_EFFECTS=off
# per-km pledges. 0 = POST /api/pledges and the live pledge routes answer 403 pledges_disabled. Set 1 only for a localnet program test.
PLEDGES_ENABLED=0
# weekly skill contest. Empty = code defaults (sanctioned draft, UK+EU, US states SC AZ LA AR DE MT TN). A non-empty list replaces that default.
PRIZE_SANCTIONED_COUNTRIES=
PRIZE_BLOCKED_COUNTRIES=
PRIZE_BLOCKED_US_STATES=
# the admin session (the page's own wallet sign-in → the fc_admin cookie, admin.<apex> only): its signing key (>= 32 chars; change it = every admin signed out;
# empty = derived from JWT_SECRET) and how long one sign-in lasts. `npm run deploy:init` generates the key.
ADMIN_JWT_SECRET=CHANGE_ME_generated_by_deploy_init
ADMIN_SESSION_TTL_MINUTES=60
MODERATOR_WALLETS=
ADMIN_IP_ALLOWLIST=
# Required in production when ADMIN_WALLETS, MODERATOR_WALLETS, or EDITOR_WALLETS is set. A real bot and chat. Secrets, only in deploy/.env.
ADMIN_ALERT_TELEGRAM_BOT_TOKEN=
ADMIN_ALERT_TELEGRAM_CHAT_ID=
# Pre-season verification (separate from alert delivery). Requires Turnstile action=preseason.
TWITTERAPI_IO_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_LOGIN_BOT=
TELEGRAM_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_APPROVAL_MODE=single
THROTTLE_ADMIN_AUTH_LIMIT=10
# wallets (comma-separated base58) that may use https://admin.<apex> (behind DEPLOY_ADMIN_USER / _PASSWORD) – the review queue, rides, sign-ins, live logs. Empty = no admin page at all.
# The default is the owner's wallet (a public address, not a secret).
ADMIN_WALLETS=GseaEsNWMLScZ5RH8yQ4xmoCP97H86HjLSA9xkyFCqbn
# the 3D model editor on https://storybook.<apex> (docs/spec/platform_services.md): wallets (comma-separated base58) that may edit and PUBLISH the game's 3D models.
# Empty = no editor (the viewer stays read-only). The default is the owner's wallet (the admin one). Its session key is required in production when any allowlist is set: ≥ 32 chars, different from JWT_SECRET and ADMIN_JWT_SECRET. Empty is development only (then derived from JWT_SECRET). A new value signs every editor out.
# EDITOR_IP_ALLOWLIST: optional IPs / CIDRs; empty = any.
EDITOR_WALLETS=GseaEsNWMLScZ5RH8yQ4xmoCP97H86HjLSA9xkyFCqbn
EDITOR_JWT_SECRET=CHANGE_ME_generated_by_deploy_init
EDITOR_SESSION_TTL_MINUTES=60
EDITOR_IP_ALLOWLIST=
# the AI model editor (the chat on the model viewer): the API/AI-worker ⇄ entity MCP secret (`npm run deploy:init` generates it; empty = no AI editor; the mcp
# and editor-worker containers are not started) and one key per AI provider – a provider is offered when its key is set. SECRETS. Model ids are env defaults (EDITOR_MODEL_*; empty = the
# code's default: grok-4.7 / claude-opus-5-5 / gpt-6 / gemini-3.1-pro-preview / glm-5.2). EDITOR_DEFAULT_PROVIDER: xai|anthropic|openai|gemini|zai (empty = the first enabled).
EDITOR_MCP_TOKEN=CHANGE_ME_generated_by_deploy_init
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4   # OpenAI-compatible, pay as you go; a GLM Coding Plan key: https://api.z.ai/api/coding/paas/v4
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
EDITOR_DEFAULT_PROVIDER=
EDITOR_MODEL_ANTHROPIC=
EDITOR_MODEL_OPENAI=
EDITOR_MODEL_GEMINI=
EDITOR_MODEL_ZAI=
EDITOR_MODEL_XAI=
EDITOR_JOB_TIMEOUT_MS=600000
# TEST ONLY – the scripted fake AI provider; the server refuses 1 in production (compose pins 0)
EDITOR_FAKE_LLM=0
EDITOR_OPEN=0
# pin the SOL/USD price (testing only). Empty = live Coinbase / CoinGecko.
SOL_USD=

# ---- escrowed pools / paid tickets (docs/spec/pool.md). All optional: without TICKET_PROGRAM_ID the server runs the legacy pay-per-ride transfer mode.
# the deployed pool program (devnet) – set it and PAYMENT_MODE defaults to 'program'
TICKET_PROGRAM_ID=
# PUBLIC keys: defaults for new pools' seed / fee treasuries
FEE_TREASURY=
SEED_TREASURY=
# websocket of the same provider (unset = no live subscription, the 15 s poll still runs); read-only fallback RPCs, comma-separated
SOLANA_WS=
SOLANA_RPC_FALLBACKS=
# program-log watcher interval (0 = off)
WATCH_INTERVAL_MS=15000
# POST /api/chain/webhook secret (>= 16 chars; unset = the route answers 404)
WEBHOOK_SECRET=
# 'program' | 'transfer'. Unset: 'program' when TICKET_PROGRAM_ID is set, else 'transfer'
PAYMENT_MODE=
# base58 keypair paying fees for the permissionless pool crank (fail_pool, expire_pool, refund, close_pool of a refunded pool) – fee money only. SECRET – never commit a real one.
# CRANK_INTERVAL_MS = how often it runs (0 = only `node dist/cli/index.js pool:crank` on the box).
CRANK_SECRET=
CRANK_INTERVAL_MS=60000
# base58 keypair the admin names on chain as the payout key (`pool-admin.mjs set-payout-authority`): after a pool's review window it pays the ranked prizes
# and closes the pool – it can open, cancel or configure nothing. It pays only its own fees. SECRET – never commit a real one.
# PAYOUT_INTERVAL_MS = how often the payout job runs (0 = only `node dist/cli/index.js pool:payout` on the box).
PAYOUT_SECRET=
PAYOUT_INTERVAL_MS=300000
# Achievements as soulbound compressed NFTs (docs/spec/web3_solana.md). OFF until all three are set. ACHIEVEMENT_MINT_SECRET = base58 keypair that created the tree
# and the collection (`node server/scripts/achievements/setup-tree.mjs`) – it mints and nothing else; it pays the mint fees. SECRET – never commit a real one.
ACHIEVEMENT_MINT_SECRET=
ACHIEVEMENT_TREE=
ACHIEVEMENT_COLLECTION=
ACHIEVEMENT_MINT_INTERVAL_MS=120000
ACHIEVEMENT_MINT_DELAY_MS=3600000
ACHIEVEMENT_MINT_BATCH=10
# freightchain_honk program id. Empty = ledger burns only; the server does not mint. Local validator: GctCYSHbCnHN8sE1LjUL9cmSpFd5mcVdfaumRcaVWZZx
HONK_PROGRAM_ID=
HONK_EMITTER_SECRET=
# the statistics cache (Redis, inside the compose network only – no published port, password required). hex – `npm run deploy:init` generates one;
# on an existing deploy/.env add it: echo "REDIS_PASSWORD=$(openssl rand -hex 24)" >> deploy/.env. The app's REDIS_URL is built from it by the compose file.
REDIS_PASSWORD=CHANGE_ME_generated_by_deploy_init
# priority fees: percentile of recent fees, clamped to [MIN, MAX] micro-lamports (use MIN=1000 on mainnet)
PRIORITY_FEE_PERCENTILE=75
PRIORITY_FEE_MIN_MICROLAMPORTS=0
PRIORITY_FEE_MAX_MICROLAMPORTS=50000
# 'confirmed' | 'finalized'
SOLANA_COMMITMENT=confirmed
# minutes a paid order stays payable; hours an on-chain session lasts (max 168)
ORDER_TTL_MINUTES=60
ONCHAIN_SESSION_TTL_HOURS=24
# minimum spacing of ride heartbeats (ms)
HB_MIN_INTERVAL_MS=1000
# a running ride with no heartbeat for this long has lost its tab: it leaves the live feed and the stale-ride sweeper ends it (failed · heartbeat lost)
HB_TIMEOUT_MS=150000
# PostHog product analytics (docs/insights/analytics/index.html). Production file.
# POSTHOG_ENABLED=1 is the production opt-in. The key stays blank here. A value that is not phc_… is logged and ignored and does not refuse boot. Do not commit a real token.
# Local development is server/.env, which pins POSTHOG_ENABLED=0. POSTHOG_DISABLED=1 still wins.
# Project 297915 is EU Cloud. The US ingest host never shows up on the EU board (docs/spec/platform_services.md).
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=297915
POSTHOG_ENABLED=1
POSTHOG_DISABLED=


# AI editor in production: Redis is required. Compose gives the MCP a restricted counter-only Redis user.
# Require hashed frame-level traffic evidence for rides started by this server.
TRAFFIC_PROOF_REQUIRED=true
# lane1:PRIZE_DEV_DEFAULT_COUNTRY — dev/test only. Production (any other NODE_ENV) ignores it and fails closed.
PRIZE_DEV_DEFAULT_COUNTRY=US

# Required in production; 32 random bytes as 64 hex characters. Missing locally disables network correlation.
IP_HASH_SECRET=

# Optional evidence providers. Credentials alone do not opt in; signed admin evidence flags default0.
IPINFO_TOKEN=
HELIUS_API_KEY=
