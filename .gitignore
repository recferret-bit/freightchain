# Generated build output (client: node tools/build-standalone.mjs; landing: vite build; server: nest build) – regenerate, don't commit
dist/
# the e2e harness's private builds (.claude/skills/run-tests/e2e.sh) – removed at the end of a run, these catch a killed one
server/.e2e-build-*/
server/.e2e-tsconfig-*.json
# the ride-audit skill's private build (.claude/skills/ride-audit/run.sh) – removed at the end of a run
server/.audit-build-*/
server/.audit-tsconfig-*.json
# the ride-review skill's private build (.claude/skills/ride-review/run.sh) – removed at the end of a run
server/.review-build-*/
server/.review-tsconfig-*.json
# a one-off tsc emit of server/src (same shape as dist/). Not a script output.
server/.guide-build/
# the test census's sourcemapped headless bundle (npm run test:census -- coverage) – removed at the end, this catches a killed run
client/.census-cov-*/

# Dependencies / package-manager leftovers (the client has none; tools are run via npx). server/ and landing/ package-lock.json ARE committed.
node_modules/
client/package-lock.json
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Media (media/): generated clips and their sound are NOT committed (regenerate: node media/make.mjs media/specs/<name>.json). Committed: the sound store media/out/audio/_store (a test checks it byte for byte)
# and media/out/video/intro/intro.mp4 (the README links it)
media/out/video/*
!media/out/video/intro/
media/out/video/intro/*
!media/out/video/intro/intro.mp4
media/out/audio/*
!media/out/audio/_store/
media/out/audio/_store/**/*.png

# Test artifacts (tools/e2e-chrome.mjs writes to the OS temp dir by default; these catch local overrides)
shots/
screenshots/
*.log
coverage/
.eslintcache

# Secrets / local config
.env
.env.*
!.env.example
!.env.devnet.example

# Claude Code local (per-user) settings – CLAUDE.md, .claude/settings.json and .claude/skills/ stay tracked
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
.agents/*

# Editors / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Server runtime data (SQLite) and build output
server/data/
*.sqlite*
*.tsbuildinfo
deploy/secrets/

# Regenerated by posthog-map and posthog-audit. No secrets.
docs/analytics/generated/

# Multi-agent teamwork artifacts. skills/ is the Gemini / Codex view of a skill (symlink, not a second copy).
.agents/*
!.agents/skills/
!.agents/skills/**
PROJECT.md

# Local social plans (TikTok warmup and the like). Not product.
social/

# Pinned native review runtimes: derived source, Cargo caches and binaries stay private.
pentest/native/.cache/
