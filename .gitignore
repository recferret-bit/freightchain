# Generated build output (client: node tools/build-standalone.mjs; landing: vite build; server: nest build) – regenerate, don't commit
dist/
# the e2e harness's private builds (.claude/skills/run-tests/e2e.sh) – removed at the end of a run, these catch a killed one
server/.e2e-build-*/
server/.e2e-tsconfig-*.json

# Dependencies / package-manager leftovers (the client has none; tools are run via npx). server/ and landing/ package-lock.json ARE committed.
node_modules/
client/package-lock.json
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Promo videos (video/): the finished clips in video/out/<name>/ ARE committed; scratch output is not
video/out/*-preview/
video/out/*-partial/
video/out/*/frames/
video/out/*/spec.resolved.json
video/out/*/*.raw

# Test artifacts (tools/e2e-chrome.mjs writes to the OS temp dir by default; these catch local overrides)
shots/
screenshots/
*.log
coverage/
.eslintcache

# Secrets / local config
.env
.env.*
!.env.example
!.env.devnet.example

# Claude Code local (per-user) settings – CLAUDE.md, .claude/settings.json and .claude/skills/ stay tracked
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Editors / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Server runtime data (SQLite) and build output
server/data/
*.sqlite*
*.tsbuildinfo
deploy/secrets/
