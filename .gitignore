# Generated build output (frontend/client: node tools/build-standalone.mjs; frontend/landing: vite build; backend/server: nest build) – regenerate, don't commit
dist/
# local nginx edge (npm run infra:local) – rendered from the templates; the dummy admin hash is in here
infra/deploy/local/out/
# the e2e harness's private builds (.claude/skills/run-tests/e2e.sh) – removed at the end of a run, these catch a killed one
backend/server/.e2e-build-*/
backend/server/.e2e-tsconfig-*.json
# the ride-audit skill's private build (.claude/skills/ride-audit/run.sh) – removed at the end of a run
backend/server/.audit-build-*/
backend/server/.audit-tsconfig-*.json
# the ride-review skill's private build (.claude/skills/ride-review/run.sh) – removed at the end of a run
backend/server/.review-build-*/
backend/server/.review-tsconfig-*.json
# a one-off tsc emit of backend/server/src (same shape as dist/). Not a script output.
backend/server/.guide-build/
# the test census's sourcemapped headless bundle (npm run test:census -- coverage) – removed at the end, this catches a killed run
frontend/client/.census-cov-*/

# Dependencies / package-manager leftovers (the client has none; tools are run via npx). backend/server/ and frontend/landing/ package-lock.json ARE committed.
node_modules/
frontend/client/package-lock.json
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Media (social/media/): generated clips and their sound are NOT committed (regenerate: node social/media/make.mjs social/media/specs/<name>.json). Committed: the sound store social/media/out/audio/_store (a test checks it byte for byte)
# and social/media/out/video/intro/intro.mp4 (the README links it)
social/media/out/video/*
!social/media/out/video/intro/
social/media/out/video/intro/*
!social/media/out/video/intro/intro.mp4
social/media/out/audio/*
!social/media/out/audio/_store/
social/media/out/audio/_store/**/*.png

# code-level e2e ledger and the API pid (infra/docker-compose.e2e.yml / tests/e2e/scripts/run.sh)
tests/e2e/.ledger/
tests/e2e/.server.pid

# Test artifacts (tools/e2e-chrome.mjs writes to the OS temp dir by default; these catch local overrides)
shots/
screenshots/
*.log
coverage/
.eslintcache

# Secrets / local config
.env
.env.*
!.env.example
!.env.devnet.example

# Claude Code local (per-user) settings – CLAUDE.md, .claude/settings.json and .claude/skills/ stay tracked
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md
.agents/*

# Editors / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Server runtime data (SQLite) and build output
backend/server/data/
*.sqlite*
*.tsbuildinfo
infra/deploy/secrets/

# Regenerated by posthog-map and posthog-audit. No secrets.
docs/insights/analytics/generated/

# Multi-agent teamwork artifacts. skills/ is the Gemini / Codex view of a skill (symlink, not a second copy).
.agents/*
!.agents/skills/
!.agents/skills/**

# Pinned native review runtimes: derived source, Cargo caches and binaries stay private.
tests/audit/native/.cache/

# Regenerated pitch-deck clip frames (social/pitchdeck-video/pitchdeck.mjs).
social/pitchdeck-video/out/
