{
  "name": "freightchain-monorepo",
  "private": true,
  "description": "Freight Chain – client/ (the game + lobby, vanilla ES modules + three.js), landing/ (the / page, Vite) and server/ (NestJS, Prisma, PostgreSQL; serves both). Each has its own package.json; these scripts just delegate.",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:landing": "npm --prefix landing install",
    "landing:dev": "npm --prefix landing run dev",
    "landing:build": "npm --prefix landing run build",
    "landing:lint": "npm --prefix landing run lint",
    "landing:test": "npm --prefix landing test",
    "treasury:init": "npm --prefix server run treasury:init",
    "server:dev": "sh -c 'set -a; [ -f deploy/local/dev.env ] && . ./deploy/local/dev.env; set +a; npm --prefix server run start:dev'",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "client:check": "npm --prefix client run check",
    "client:serve": "client/serve.sh",
    "check": "npm run client:check && npm run landing:lint && npm run landing:build && npm run landing:test && npm run server:build && npm run server:typecheck && npm run server:test && npm run mcp:check && npm run media:check",
    "db:up": "npm --prefix server run db:up",
    "db:down": "npm --prefix server run db:down",
    "db:migrate": "npm --prefix server run prisma:deploy",
    "editor:mcp": "FC_APP_URL=${FC_APP_URL:-http://127.0.0.1:3000} node --env-file-if-exists=server/.env mcp/src/http.js",
    "mcp:check": "npm --prefix mcp test",
    "entities:export": "npm --prefix server run build && npm --prefix server run entities:export",
    "server:integration": "npm --prefix server run test:integration:stack",
    "server:typecheck": "npm --prefix server run typecheck",
    "program:build": "cd programs && anchor build --arch v0",
    "program:test": "cd programs && cargo test",
    "program:verify": "bash .claude/skills/program-check/check.sh",
    "test:localnet": "bash .claude/skills/localnet-e2e/run.sh",
    "test:e2e:block1": "bash e2e/scripts/run.sh 1",
    "test:e2e:block2": "bash e2e/scripts/run.sh 2",
    "test:e2e:pages": "npm --prefix e2e run test:pages",
    "test:census": "node .claude/skills/test-census/census.mjs",
    "program:idl": "cp programs/target/idl/freightchain_pools.json programs/idl/freightchain_pools.json",
    "infra:local": "bash deploy/scripts/local.sh",
    "deploy": "bash deploy/scripts/deploy.sh",
    "deploy:init": "bash deploy/scripts/init.sh",
    "deploy:setup": "bash deploy/scripts/setup.sh",
    "deploy:status": "bash deploy/scripts/ctl.sh status",
    "deploy:logs": "bash deploy/scripts/ctl.sh logs",
    "deploy:backup": "bash deploy/scripts/ctl.sh backup",
    "deploy:rollback": "bash deploy/scripts/ctl.sh rollback",
    "deploy:smoke": "bash deploy/scripts/ctl.sh smoke",
    "deploy:stats": "bash deploy/scripts/ctl.sh stats",
    "ops": "bash deploy/scripts/ops.sh",
    "media": "node media/make.mjs",
    "media:store": "node media/audio/cli.mjs store",
    "media:game-sfx": "node media/audio/cli.mjs game",
    "media:check": "npm --prefix media run lint && npm --prefix media test",
    "install:media": "npm --prefix media install",
    "build": "npm run landing:build && npm run server:build",
    "editor:worker": "sh -c 'set -a; [ -f deploy/local/dev.env ] && . ./deploy/local/dev.env; set +a; npm --prefix server run editor:worker'"
  }
}
