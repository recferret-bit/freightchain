{
  "name": "freightchain",
  "private": true,
  "type": "module",
  "description": "Freight Chain (no runtime deps; three.js comes from a CDN)",
  "scripts": {
    "serve": "./serve.sh",
    "build": "node tools/build-standalone.mjs",
    "bundle:check": "npx esbuild js/main.js --bundle --external:three --format=esm --outfile=${TMPDIR:-/tmp}/fc.js",
    "lint": "npx eslint shared js site tools",
    "test": "node --test test/*.test.mjs && sh tools/trace.sh run",
    "test:unit": "node --test test/*.test.mjs",
    "test:headless": "sh tools/trace.sh run",
    "trace:save": "sh tools/trace.sh save",
    "trace:diff": "sh tools/trace.sh diff",
    "test:e2e": "node tools/e2e-chrome.mjs",
    "check": "npm run lint && npm run test:unit && npm run bundle:check && npm run test:headless",
    "test:viewer": "node tools/e2e-viewer.mjs",
    "test:parity": "node tools/parity/run.mjs",
    "test:tickets-stub": "node tools/test-tickets-stub.mjs"
  }
}
