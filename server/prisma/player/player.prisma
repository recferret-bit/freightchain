// A rider = a Solana wallet. The wallet address IS the primary key (it is the identity; there is no email / password).
model Player {
  wallet       String              @id
  version      Int                 @default(1) // optimistic lock for save()
  freeRides    Int // credits: 5 at signup, +1 per UTC day (no backlog), never above freeRidesMax
  freeDay      String // UTC day (YYYY-MM-DD) of the last daily grant
  freeRidesMax Int                 @default(5) // the daily grant stops at this many credits
  createdAt    DateTime
  rides        Ride[]
  payments     Payment[]
  achievements AchievementUnlock[]
  tickets      RideTicket[]
  orders       TicketOrder[]
  signIns      SignIn[]

  @@schema("player")
}

// Sign-In With Solana challenge: one pending per wallet, consumed (deleted) by the first verify attempt.
model AuthChallenge {
  wallet    String   @id
  message   String // the exact text the wallet must sign – built by the server
  expiresAt DateTime

  @@schema("player")
}

enum TicketSource {
  payment
  promo
  admin
  spend
  refund
  void

  @@schema("player")
}

// A wallet's tickets in ONE pool (balance = still unused, bought = ever paid on chain, so the pool's per-wallet cap can be checked). Mirrors Player.freeRides.
model RideTicket {
  wallet  String
  player  Player @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  poolId  Int
  pool    Pool   @relation(fields: [poolId], references: [id])
  balance Int    @default(0)
  bought  Int    @default(0)
  version Int    @default(1) // optimistic lock for save()

  @@id([wallet, poolId])
  @@index([poolId])
  @@schema("player")
}

// Every change of a ticket balance – append-only audit trail (admin panel, support, "why do I have N tickets").
model TicketGrant {
  id     String       @id @default(uuid())
  wallet String
  poolId Int
  delta  Int // +n (payment / promo / admin / refund), -1 (spend), -n (void); 0 = a payment that hit the cap (see ref)
  source TicketSource
  ref    String? // Payment.signature, PromoCode.code, admin note or Ride.id
  at     DateTime

  @@index([wallet, at])
  @@index([poolId])
  @@schema("player")
}

// One row per successful sign-in (verify): the admin page's view of who signs in, when and from where. Sessions themselves are signed cookies
// (JWT) – there is no session table, and a single session cannot be revoked (rotating JWT_SECRET signs everybody out).
model SignIn {
  id        BigInt   @id @default(autoincrement())
  wallet    String
  player    Player   @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
  at        DateTime
  ip        String? // the client's address as Express sees it (TRUST_PROXY)
  userAgent String?

  @@index([at])
  @@index([wallet, at])
  @@schema("player")
}
