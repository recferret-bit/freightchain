enum RoundStatus {
  open
  closed

  @@schema("economy")
}

// ONE global weekly prize round (UTC Monday → Monday).
model Round {
  id       Int         @id @default(autoincrement())
  startsAt DateTime    @unique // a unique start makes concurrent "first request of the week" safe
  endsAt   DateTime
  carry    BigInt // lamports seeded in from the previous round (its 20 % "next ride start")
  status   RoundStatus
  payments Payment[]
  rides    Ride[]
  pools    Pool[]

  @@schema("economy")
}

model Payment {
  signature String   @id // a transaction can pay for exactly one ride
  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])
  wallet    String
  player    Player   @relation(fields: [wallet], references: [wallet])
  lamports  BigInt // what was ordered (the verified transfer was at least this)
  usd       Float
  roundId   Int
  round     Round    @relation(fields: [roundId], references: [id])
  at        DateTime

  @@index([roundId])
  @@index([wallet])
  @@schema("economy")
}

enum PoolStatus {
  open // selling tickets, the minimum is not reached yet
  active // minimum reached: rides count, entries keep selling until playDeadline
  refunding // failed, cancelled by the admin or expired unsettled: every buyer can claim every lamport back
  settled // an active pool closed: prizes paid, seed and fees sent to their treasuries
  cancelled // a refunding pool closed after every refund (terminal; the program's status 4)

  @@schema("economy")
}

enum OrderStatus {
  awaiting_payment
  paid
  expired
  refunded

  @@schema("economy")
}

// The server's mirror of an ON-CHAIN pool account (the chain is the truth; the watcher and PoolSyncService keep this row in step).
model Pool {
  id            Int           @id // the on-chain pool_id (u32 chosen at creation) - not generated here
  address       String        @unique // the Pool PDA
  tier          String // '1h' | '4h' | '8h'
  label         String
  priceLamports BigInt
  minTickets    Int
  maxTickets    Int // 0 = unlimited
  maxPerWallet  Int
  prepDeadline  DateTime // the sale window ends here (open or active); under the minimum the pool fails
  playDeadline  DateTime // rides count until then
  payoutAt      DateTime // the review window ends here: prizes and the close only from then on (the program enforces it)
  prizeBps      Int
  seedBps       Int
  feeBps        Int
  referralBps   Int           @default(0) // 0 = a pool from before the referral leg (prize/seed/fee only)
  feeTreasury   String
  seedTreasury  String
  status        PoolStatus
  ticketsSold   Int           @default(0)
  buyers        Int           @default(0)
  vaultLamports BigInt        @default(0) // the escrow: vault lamports above its rent-exempt minimum, sponsorships included
  sponsored     BigInt        @default(0)
  roundId       Int? // the weekly round it ranks in (set when it goes active)
  rideSeed      Int // the road seed EVERY ride of this pool is driven on (31-bit: from the chain's seed commitment; set once – a v4 pool registered before its road was sealed gets it at the seal)
  round         Round?        @relation(fields: [roundId], references: [id])
  createdAt     DateTime
  syncedAt      DateTime?
  payoutState   String        @default("pending") // the payout job: pending | waiting_review | held | committed | paying | paid | no_winners | error
  payoutNote    String?
  holdBy        String? // an admin's signed hold on the payout (wallet), null = none
  holdAt        DateTime?
  holdNote      String?
  seedCommitment String?
  blockhash      String?
  slot           BigInt?
  sealSlot       BigInt? // program v4: the slot whose hash seals the road; > 0 with no seedCommitment = not sealed, no ride served
  winnersRoot    String? // program v4: the committed winners root (base64) – public until payFrom
  committedAt    DateTime?
  payFrom        DateTime?
  payouts       PoolPayout[]
  tickets       RideTicket[]
  orders        TicketOrder[]
  rides         Ride[]
  pledges       Pledge[]

  @@index([status, prepDeadline])
  @@index([status, playDeadline])
  @@index([status, payoutAt(sort: Desc)])
  @@index([roundId])
  @@index([createdAt]) // the admin POOLS list: newest first
  @@schema("economy")
}

// One leaf the server's payout job pays from a pool (the payout key signs pay_prize). The row is written BEFORE the transaction goes out: `planned` →
// `sent` (signature + lastValidBlockHeight stored, then broadcast) → `paid` once confirmed. A crash after `sent` is resolved from the signature's status (landed =
// paid, expired = planned again), never by sending blind. One leaf per rank. A wallet who both finishes and referred someone has two rows, distinguished by kind.
model PoolPayout {
  poolId               Int
  rank                 Int
  wallet               String
  kind                 String    @default("rider") // rider | referrer
  lamports             BigInt
  status               String // planned | sent | paid
  signature            String?   @unique
  lastValidBlockHeight Int?
  attempts             Int       @default(0)
  error                String?
  createdAt            DateTime
  updatedAt            DateTime
  pool                 Pool      @relation(fields: [poolId], references: [id])

  @@id([poolId, rank])
  @@unique([poolId, wallet, kind])
  @@schema("economy")
}

// A promo code has ONE effect (kind): ride (one free 1h/4h/8h shift, not a purchase), tickets (an off-chain grant into a pool - a sponsored entry; it does
// not count towards the pool's minimum), free_rides (retired; old rows still load) or cosmetic (old unlocks). Immutable once created, apart from disabledAt.
model PromoCode {
  code           String            @id // stored upper-case without spaces; redeemed case-insensitively
  kind           String            @default("tickets") // ride | tickets | free_rides | cosmetic
  poolId         Int? // tickets: null = the newest open/active pool of `tier`
  tier           String? // ride or tickets: 1h | 4h | 8h
  credits        Int? // tickets: tickets per redemption
  freeRides      Int? // free_rides: rides per redemption (retired; kept so an old row still loads)
  grants         PromoRideGrant[]
  cosmeticSlot   String? // cosmetic
  cosmeticItem   String? // cosmetic
  description    String? // player-facing text
  maxRedemptions Int? // null = unlimited
  redeemed       Int               @default(0)
  perWallet      Int               @default(1)
  startsAt       DateTime // redeemable from here ...
  expiresAt      DateTime? // ... until here (null = no end)
  disabledAt     DateTime?
  note           String? // the admin's private note
  createdAt      DateTime
  redemptions    PromoRedemption[]

  @@schema("economy")
}

model PromoRedemption {
  code   String
  promo  PromoCode @relation(fields: [code], references: [code])
  wallet String
  n      Int // the n-th redemption of this code by this wallet (1..perWallet): the primary key IS the per-wallet limit
  at     DateTime

  @@id([code, wallet, n])
  @@index([wallet])
  @@index([at])
  @@schema("economy")
}

// One unspent or spent ride from a `ride` promo. The redemption row stays even after the ride is created. rideId null = still waiting to be ordered.
model PromoRideGrant {
  code      String
  wallet    String
  n         Int
  tier      String
  rideId    String?   @unique
  createdAt DateTime
  promo     PromoCode @relation(fields: [code], references: [code])

  @@id([code, wallet, n])
  @@index([wallet, tier, rideId])
  @@schema("economy")
}

// An order for tickets: the wallet says "n tickets of pool X", the server builds the transaction, the chain event settles it.
model TicketOrder {
  id                   String      @id @default(uuid()) // = the on-chain order_id (the uuid's 16 bytes)
  wallet               String
  player               Player      @relation(fields: [wallet], references: [wallet])
  poolId               Int
  pool                 Pool        @relation(fields: [poolId], references: [id])
  qty                  Int
  lamports             BigInt // price x qty at order time (the price is fixed on the pool)
  status               OrderStatus
  txMessage            String? // base64 of the message the server built for this order (the wallet signs and sends it itself)
  lastValidBlockHeight BigInt?
  createdAt            DateTime
  paidAt               DateTime?
  refundedAt           DateTime?
  signature            String? // the transaction whose TicketBought event paid it
  eventIndex           Int? // that event's position in the transaction – (signature, eventIndex) is unique: one purchase event pays one order
  paymentReference     String? @unique // Solana Pay reference on the buy_ticket memo. Null on an order from before reference keys.

  @@unique([signature, eventIndex])
  @@index([wallet, status])
  @@index([poolId])
  @@schema("economy")
}

// Where the program-log watcher stopped (key 'program'): the newest signature it has fully handled.
model ChainCursor {
  key       String   @id
  signature String?
  slot      BigInt?
  at        DateTime

  @@schema("economy")
}

// Every program event the server saw, one row per event: nothing observed on chain is ever lost silently. The (signature, index) key makes handling idempotent.
model ChainEvent {
  signature            String
  index                Int
  kind                 String // TicketBought | PoolActivated | PoolFailed | Refunded | Sponsored | PrizePaid | PoolClosed | PoolCreated | PoolCancelled
  poolId               Int?
  wallet               String?
  orderId              String?
  lamports             BigInt?
  outcome              String // settled | unmatched | invalid | duplicate | applied | dropped
  detail               String?
  at                   DateTime
  finalizedAt          DateTime? // stamped by the finality pass
  lastValidBlockHeight BigInt?

  @@id([signature, index])
  @@index([outcome, at])
  @@index([finalizedAt])
  @@index([poolId])
  @@schema("economy")
}

// A community sponsorship pledge for a ride
model Pledge {
  id               String    @id @default(uuid())
  pdaAddress       String    @unique
  rideId           String
  ride             Ride      @relation(fields: [rideId], references: [id])
  sponsor          String
  sponsorPlayer    Player    @relation("SponsorPledges", fields: [sponsor], references: [wallet])
  driver           String
  driverPlayer     Player    @relation("DriverPledges", fields: [driver], references: [wallet])
  poolId           Int
  pool             Pool      @relation(fields: [poolId], references: [id])
  maxLamports      BigInt
  lamportsPerKm    BigInt
  targetKm         Int
  /// pending | active | settled | refunded | abandoned (domain/economy/pledge.types.ts)
  status           String    @default("pending")
  /// the create_pledge transaction
  createSignature  String?
  settled          Boolean   @default(false)
  earnedLamports   BigInt    @default(0)
  refundedLamports BigInt    @default(0)
  createdAt        DateTime
  settledAt        DateTime?
  signature        String?
  slot             BigInt?
  blockhash        String?

  @@unique([rideId, sponsor])
  @@index([driver, settled])
  @@index([sponsor, settled])
  @@index([poolId])
  @@index([rideId])
  @@index([status, poolId])
  @@schema("economy")
}

// TEN4 ledger (docs/spec/ten4.md). Base units, 6 decimals. Table names stay Honk*. The emission counter is reserved ride TEN4, pending 8h rows included.
model HonkAccount {
  wallet    String   @id
  balance   BigInt   @default(0)
  minted    BigInt   @default(0)
  burned    BigInt   @default(0)
  updatedAt DateTime

  @@schema("economy")
}

model HonkMint {
  rideId    String   @id
  wallet    String
  tier      String
  amount    BigInt
  band20    Boolean
  band50    Boolean
  band100   Boolean
  createdAt DateTime
  /// When an 8h reservation may credit the wallet. Rows from before the hold were already credited.
  releaseAt DateTime @default(now())
  released  Boolean  @default(true)

  @@index([wallet])
  @@index([released, releaseAt])
  @@schema("economy")
}

model HonkBurn {
  id        String   @id
  wallet    String
  amount    BigInt
  kind      String
  ref       String
  createdAt DateTime

  @@index([wallet, createdAt])
  @@schema("economy")
}

model HonkVisual {
  id             String   @id
  wallet         String
  slot           String
  item           String
  amount         BigInt
  createdAt      DateTime
  chainMint      String?
  chainSignature String?

  @@unique([wallet, slot, item])
  @@schema("economy")
}

model HonkSupply {
  id     Int    @id @default(1)
  minted BigInt @default(0)

  @@schema("economy")
}

// Cab parts. price null is the slot default (not for sale). A visual burn charges this row, in base units.
model HonkPart {
  slot        String
  item        String
  name        String
  description String
  price       BigInt?
  sort        Int

  @@id([slot, item])
  @@schema("economy")
}


