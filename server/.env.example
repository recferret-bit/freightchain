# Copy to .env in server/ (read by Prisma and, at start, by the server). Only DATABASE_URL is required in dev.
PORT=3000
NODE_ENV=development
# PostgreSQL (docker compose up -d --wait postgres from the repo root, or `npm run db:up` here)
DATABASE_URL=postgresql://freight:freight_dev_password@localhost:15433/freightchain
# TEST_DATABASE_URL=postgresql://freight:freight_dev_password@localhost:15433/freightchain_test   # the integration suite's own database (this is the default; it is wiped before every test – the name must end in _test)
JWT_SECRET=                        # >= 32 chars; REQUIRED when NODE_ENV=production. Empty in dev = a random secret per boot (sessions end on every restart / --watch reload)
SESSION_TTL_DAYS=7
APP_DOMAIN=localhost:3000          # shown in the wallet's sign-in message – the real host when deployed
APP_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=                     # split hosts only (landing / ride.* / api.*): the session cookie's Domain, e.g. freightchain.fun – shared by all subdomains. Empty = host-only cookie (single origin)
CORS_ORIGINS=                      # split hosts only: comma-separated browser origins allowed to call the API with the cookie, e.g. https://freightchain.fun,https://ride.freightchain.fun. Empty = CORS off
CLIENT_DIR=                        # folder served as the site (default: ../client)
LANDING_DIR=                       # the landing's Vite build, served at / in front of the site (default: ../landing/dist; absent = / is client/index.html). The Docker image sets it
TRUST_PROXY=0                      # reverse-proxy hops in front of the server (Railway / Fly: 1). REQUIRED in production – per-IP rate limits are wrong without it
THROTTLE_LIMIT=600                 # requests per minute per IP (global)
THROTTLE_AUTH_LIMIT=30             # requests per minute per IP on /api/auth/*
# --- game rules / economy ---
FREE_RIDE_SECONDS=180              # test/demo override only
HB_MIN_INTERVAL_MS=1000
HB_TIMEOUT_MS=150000              # no heartbeat this long = the tab is gone: off the live feed, and the sweeper ends it (failed · heartbeat lost)
# --- Solana / payments ---
TREASURY_PUBKEY=                   # where entry fees go (PUBLIC key only). REQUIRED in production.
                                   # dev: `npm run treasury:init` writes data/treasury.json, read when this is empty
# devnet only (the deploy refuses another chain); a dedicated devnet URL holds an API key – keep it in .env, never in git
SOLANA_RPC=https://api.devnet.solana.com
SOL_USD=                           # pins the price (tests / offline demo); empty = Coinbase, then CoinGecko, cached 60 s
DEMO_WALLETS=                      # comma-separated wallets (or *) whose PAID rides run DEMO_SCALE× shorter – for the video
DEMO_SCALE=60
INITIAL_SEED_SOL=0                 # money the very first round starts with
# --- verified play / admin ---
VERDICT_ENFORCE=true               # false = SHADOW mode: rides are judged and the verdict shown, but the paid boards ignore it (the tuning week)
TELEMETRY_RETENTION_DAYS=90        # days a ride's recording is kept after it ended (flagged rides until reviewed); 0 = forever
SIGNIN_RETENTION_DAYS=180          # days the sign-in log (wallet, time, IP, browser) is kept; 0 = forever
CHALLENGE_INTERVAL_SECONDS=240     # verified play: seconds of driving between two dispatch prompts ("flash your headlights"); a short shift gets at most 4; 0 = none
# --- live streams (spectators: docs/replay-and-donations) – feature flags, enforced by the server and shown/hidden by the watch page + the driver's CB ---
LIVE_CHAT=all                      # spectators' chat: all rides | free (free test rides only) | off
LIVE_DONATIONS=on                  # on | off – any donation (tips and effects)
LIVE_FREE_DONATIONS=on             # on = MOCK donations, nothing charged | off = a real SOL transfer to the driver, verified on chain
LIVE_EFFECTS=all                   # donations that change the ride (night / day / holes): all rides | free (free test rides only) | off (tips only)
ADMIN_WALLETS=                     # comma-separated wallets that may open /admin.html; empty = no admin surface (404). Local without a wallet extension: 64GheTAtcPoz6Re29qwWxzKU2gtZCTF6gC1NBPVgaL2N = the page's DEV WALLET button (client/site/dev-wallet.js, localhost only) – never in deploy/.env
# --- admin session (see deploy/.env.example) ---
ADMIN_JWT_SECRET=                  # >= 32 chars; empty = derived from JWT_SECRET
ADMIN_SESSION_TTL_MINUTES=120
# --- escrowed pools / paid tickets (docs/paid-tickets-status.md); all optional – without TICKET_PROGRAM_ID the server runs the plain transfer mode ---
PAYMENT_MODE=                      # program | transfer; empty = program when TICKET_PROGRAM_ID is set
TICKET_PROGRAM_ID=
FEE_TREASURY=                      # PUBLIC keys: defaults for new pools
SEED_TREASURY=
SOLANA_WS=                         # empty = derived from SOLANA_RPC
SOLANA_RPC_FALLBACKS=              # comma-separated read-only fallbacks
SOLANA_COMMITMENT=confirmed        # confirmed | finalized
WATCH_INTERVAL_MS=15000            # program-log watcher; 0 = off
WEBHOOK_SECRET=                    # >= 16 chars; empty = POST /api/chain/webhook answers 404
CRANK_SECRET=                      # SECRET base58 keypair for the permissionless cranks (fail / expire / refund / close a refunded pool) – fee money only
CRANK_INTERVAL_MS=60000            # pool crank schedule with CRANK_SECRET set; 0 = only `node dist/cli/index.js pool:crank`
FEE_PAYER_SECRET=                  # SECRET base58 gas-sponsor keypair; empty = buyers pay their own fee
FEE_PAYER_MIN_SOL=0.05
SPONSOR_PER_WALLET_PER_DAY=20
PRIORITY_FEE_PERCENTILE=75
PRIORITY_FEE_MIN_MICROLAMPORTS=0   # 1000 on mainnet
PRIORITY_FEE_MAX_MICROLAMPORTS=50000
ORDER_TTL_MINUTES=60
ONCHAIN_SESSION_TTL_HOURS=24
# --- PostHog (docs/analytics/index.html). Local development. main's schema strips these. ---
# This file is the dev server. POSTHOG_ENABLED=0 keeps capture off even if a project token is filled in.
# Production is deploy/.env, which sets POSTHOG_ENABLED=1. Never commit a real token.
POSTHOG_KEY=                       # phc_… only. A phx_ or other bad value is logged and ignored and does not stop the server.
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=297915          # notes only; capture does not send it. Not a secret.
POSTHOG_ENABLED=0                  # local stays off. 1 or true would send; production sets that in deploy/.env.
POSTHOG_DISABLED=                  # 1 or true forces capture off even when POSTHOG_ENABLED is on. Empty, 0, or false does not.
