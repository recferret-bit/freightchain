# Copy to .env in server/ (read at start by src/config.ts) or set these in your host's env settings. None are required in dev,
# but set JWT_SECRET to stay signed in across restarts.
PORT=3000
APP_DOMAIN=localhost:3000          # shown in the wallet's sign-in message – the real host when deployed
APP_ORIGIN=http://localhost:3000
JWT_SECRET=                        # REQUIRED when NODE_ENV=production (dev uses a random one per boot)
DB_PATH=data/freightchain.sqlite
FREE_RIDE_SECONDS=180              # test/demo override only
