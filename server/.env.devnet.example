# The LOCAL DEVNET profile (docs/escrow-open-items.md Phases 1–2): this machine's server against the program on Solana DEVNET, its own database.
# Copy to server/.env.devnet (gitignored) – `bash server/scripts/devnet.sh env` writes it from the keys in deploy/secrets/devnet/ and asks for the RPC.
# Used with ENV_FILE=.env.devnet (server/scripts/devnet.sh server | cli …). Keys this file sets win over server/.env; anything it leaves out falls back to .env.
# SECRETS (FEE_PAYER_SECRET, CRANK_SECRET, WEBHOOK_SECRET, the RPC URL with its token) go only into the real .env.devnet – never into this example.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://freight:freight_dev_password@localhost:15433/freightchain_devnet

# QuickNode devnet endpoint (HTTP + WSS). It must answer getProgramAccounts (the crank) – `bash server/scripts/devnet.sh check-rpc` checks it.
SOLANA_RPC=https://example.solana-devnet.quiknode.pro/TOKEN/
SOLANA_WS=wss://example.solana-devnet.quiknode.pro/TOKEN/
SOLANA_RPC_FALLBACKS=https://api.devnet.solana.com   # READS fall back here when the primary answers 429 (rate limit); sends stay on the primary
SOLANA_COMMITMENT=confirmed

# the program and its money
PAYMENT_MODE=program
TICKET_PROGRAM_ID=
TREASURY_PUBKEY=                 # = the admin (Config.authority): payouts are served only to this wallet
FEE_TREASURY=
SEED_TREASURY=
FEE_PAYER_SECRET=                # SECRET – the gas sponsor keypair (JSON array or base58)
CRANK_SECRET=                    # SECRET – the crank keypair
CRANK_INTERVAL_MS=60000
WATCH_INTERVAL_MS=15000
WEBHOOK_SECRET=                  # SECRET – the QuickNode Stream sends it as the x-webhook-secret header

# testing conveniences (devnet only)
SOL_USD=118
DEMO_WALLETS=*
DEMO_SCALE=60
VERDICT_ENFORCE=true
POSTHOG_ENABLED=0
